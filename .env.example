# Product name in the header, titles and copy.
VITE_APP_NAME=Accounts

# Where spring-iam runs. /api/** is proxied there. Read at build time.
IAM_URL=http://localhost:8080

# Extra origins that ?continue= may send users to after sign-in, comma-separated.
# Same-origin is always allowed. Leave empty unless the IAM lives on another origin.
VITE_TRUSTED_ORIGINS=
